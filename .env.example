# Copy this file to .env. Never commit real credentials or cookies.
# Relative paths are resolved from the repository root.
RADAR_DATA_ROOT=.local\data
RADAR_OUTPUT_ROOT=.local\outputs
RADAR_RUNS_ROOT=.local\runs
RADAR_TOOLS_ROOT=.tools
RADAR_LIBRARY_ROOT=library

# Optional overrides. Leave blank when the command is available on PATH.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_FLASH_MODEL=
DEEPSEEK_PRO_MODEL=
RADAR_COMMUNITY_VERSIONS_ROOT=
RADAR_AGENT_REACH_HOME=
RADAR_AGENT_REACH_EXE=
RADAR_OPENCLI_EXE=
RADAR_NODE_EXE=
RADAR_PYTHON_EXE=
RADAR_NODE_MODULES=
RADAR_UV_EXE=
RADAR_NPM_EXE=
# Optional: reuse the local Hermes provider configuration without copying keys
# into this repository. The file itself must remain outside Git.
RADAR_HERMES_ENV=
LAST30DAYS_REASONING_PROVIDER=openai
LAST30DAYS_PLANNER_MODEL=deepseek-v4-flash
LAST30DAYS_RERANK_MODEL=deepseek-v4-flash
LAST30DAYS_OPENAI_API_STYLE=chat_completions
RADAR_LAST30DAYS_TIMEOUT_SECONDS=900

# Full last30days Skill mode (skill30).  This mirrors the normal Skill source
# surface; sources that need an account/key are reported honestly until set up.
# 默认不请求 X；账号型平台可按需补回并提供对应凭据。
RADAR_LAST30DAYS_SOURCES=reddit,youtube,tiktok,instagram,hackernews,polymarket,github,digg,arxiv,techmeme,grounding
# Optional: enables TikTok/Instagram (and paid Reddit/YouTube fallbacks) in the vendored Skill.
# SCRAPECREATORS_API_KEY=
# High-recall caps for the normal Skill pipeline (leave blank for adapter defaults).
RADAR_LAST30DAYS_MAX_RESULTS=
RADAR_LAST30DAYS_MAX_PER_SOURCE=
RADAR_LAST30DAYS_MAX_SOURCE_FETCHES=
