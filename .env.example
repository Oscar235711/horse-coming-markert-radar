# Copy this file to .env. Never commit real credentials or cookies.
# Relative paths are resolved from the repository root.
RADAR_DATA_ROOT=.local\data
RADAR_OUTPUT_ROOT=.local\outputs
RADAR_RUNS_ROOT=.local\runs
RADAR_TOOLS_ROOT=.tools

# Optional overrides. Leave blank when the command is available on PATH.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_FLASH_MODEL=
DEEPSEEK_PRO_MODEL=
RADAR_COMMUNITY_VERSIONS_ROOT=
RADAR_AGENT_REACH_HOME=
RADAR_AGENT_REACH_EXE=
RADAR_OPENCLI_EXE=
RADAR_NODE_EXE=
RADAR_PYTHON_EXE=
RADAR_NODE_MODULES=
RADAR_UV_EXE=
RADAR_NPM_EXE=
