{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horse-coming-radar/schemas/analysis.schema.json",
  "title": "Opportunity Radar Analysis Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "scope",
    "metrics",
    "executive_summary",
    "seller_verdict",
    "opportunities",
    "candidate_signals",
    "competitors",
    "personas",
    "pain_points",
    "hotspots",
    "evidence",
    "configuration_suggestions",
    "analysis_engine",
    "privacy_note"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "seasonality_in_scope", "geography_rule"],
      "properties": {
        "country": { "type": "string" },
        "seasonality_in_scope": { "type": "boolean" },
        "geography_rule": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posts_analyzed",
        "comments_analyzed",
        "us_posts",
        "unknown_geography_posts",
        "excluded_non_us_posts",
        "communities"
      ],
      "properties": {
        "posts_analyzed": { "type": "integer", "minimum": 0 },
        "comments_analyzed": { "type": "integer", "minimum": 0 },
        "us_posts": { "type": "integer", "minimum": 0 },
        "unknown_geography_posts": { "type": "integer", "minimum": 0 },
        "excluded_non_us_posts": { "type": "integer", "minimum": 0 },
        "communities": { "type": "integer", "minimum": 0 }
      }
    },
    "executive_summary": { "type": "string" },
    "seller_verdict": { "type": "string" },
    "opportunities": { "type": "array" },
    "candidate_signals": { "type": "array" },
    "competitors": { "type": "array" },
    "personas": { "$ref": "./user_profile.schema.json" },
    "pain_points": { "type": "array" },
    "hotspots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["communities", "pains", "behavior_segments"],
      "properties": {
        "communities": { "type": "array" },
        "pains": { "type": "array" },
        "behavior_segments": { "type": "array" }
      }
    },
    "evidence": { "type": "array" },
    "configuration_suggestions": { "type": "array" },
    "analysis_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "llm", "active_result"],
      "properties": {
        "rules": { "type": "object" },
        "llm": { "type": "object" },
        "active_result": { "type": "string" }
      }
    },
    "privacy_note": { "type": "string" }
  }
}
