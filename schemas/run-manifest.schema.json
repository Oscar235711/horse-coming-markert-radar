{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-manifest.schema.json",
  "title": "Opportunity Radar Run Manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "transport", "updated_at", "counts"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "partial"] },
    "transport": { "enum": ["opencli", "public-json", "fixture"] },
    "updated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "required": ["candidates", "details", "comments", "failures"],
      "properties": {
        "candidates": { "type": "integer", "minimum": 0 },
        "details": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
