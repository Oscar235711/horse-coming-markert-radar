{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-manifest.schema.json",
  "title": "Opportunity Radar Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "sample_status", "persona_status", "transport", "updated_at", "counts", "artifacts"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "partial", "failed"] },
    "sample_status": { "enum": ["sufficient", "insufficient"] },
    "persona_status": { "enum": ["complete", "insufficient_sample"] },
    "transport": { "enum": ["opencli", "public-json", "fixture"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "deep_dive_target",
        "details",
        "comments",
        "author_candidates",
        "authors_collected",
        "author_activities",
        "keyword_candidates",
        "round_two_terms",
        "round_two_additions",
        "round_two_failures",
        "failures",
        "opportunities",
        "candidate_signals",
        "audience_nodes",
        "audience_edges",
        "keyword_cloud_terms"
      ],
      "properties": {
        "candidates": { "type": "integer", "minimum": 0 },
        "deep_dive_target": { "type": "integer", "minimum": 0 },
        "details": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "author_candidates": { "type": "integer", "minimum": 0 },
        "authors_collected": { "type": "integer", "minimum": 0 },
        "author_activities": { "type": "integer", "minimum": 0 },
        "keyword_candidates": { "type": "integer", "minimum": 0 },
        "round_two_terms": { "type": "integer", "minimum": 0 },
        "round_two_additions": { "type": "integer", "minimum": 0 },
        "round_two_failures": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "opportunities": { "type": "integer", "minimum": 0 },
        "candidate_signals": { "type": "integer", "minimum": 0 },
        "audience_nodes": { "type": "integer", "minimum": 0 },
        "audience_edges": { "type": "integer", "minimum": 0 },
        "keyword_cloud_terms": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis",
        "evidence",
        "audience_map",
        "keyword_cloud",
        "opportunities",
        "personas",
        "quality_evidence",
        "excluded_evidence",
        "report",
        "optimization_backlog",
        "failures"
      ],
      "properties": {
        "analysis": { "const": "analysis.json" },
        "evidence": { "const": "evidence.jsonl" },
        "audience_map": { "const": "audience_map.json" },
        "keyword_cloud": { "const": "keyword_cloud.json" },
        "opportunities": { "const": "opportunities.json" },
        "personas": { "const": "personas.json" },
        "quality_evidence": { "const": "quality_evidence.jsonl" },
        "excluded_evidence": { "const": "excluded_evidence.jsonl" },
        "report": { "const": "report.html" },
        "optimization_backlog": { "const": "optimization_backlog.jsonl" },
        "failures": { "const": "failures.jsonl" }
      }
    }
  }
}
