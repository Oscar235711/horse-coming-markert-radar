{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dsv4pro-enrichment.schema.json",
  "title": "DSV4Pro Enrichment Patch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "executive_summary": { "$ref": "#/$defs/cited_text" },
    "seller_verdict": { "$ref": "#/$defs/cited_text" },
    "opportunities": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    },
    "candidate_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    },
    "competitors": {
      "type": "array",
      "items": { "$ref": "#/$defs/competitor" }
    }
  },
  "$defs": {
    "cited_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cited_text" }
        },
        "inferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/cited_text" }
        },
        "unknowns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "why_not_done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["fact", "inference", "unknown"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "verdict": { "type": "string", "minLength": 1 },
        "solution_ideas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fitment_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "claims": { "$ref": "#/$defs/claims" },
        "why_not_done": { "$ref": "#/$defs/why_not_done" }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence_ids"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
