{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horse-coming-radar/schemas/user_profile.schema.json",
  "title": "Persona Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "persona_status",
    "thresholds",
    "counts",
    "missing",
    "aggregate_context",
    "clusters",
    "privacy_note"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "enum": ["complete", "insufficient_sample"] },
    "persona_status": { "enum": ["complete", "insufficient_sample"] },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_evidence",
        "qualified_users",
        "deep_dive_authors",
        "cluster_members",
        "representative_users",
        "representative_activities",
        "demographic_cohort"
      ],
      "properties": {
        "qualified_evidence": { "type": "integer", "minimum": 1 },
        "qualified_users": { "type": "integer", "minimum": 1 },
        "deep_dive_authors": { "type": "integer", "minimum": 1 },
        "cluster_members": { "type": "integer", "minimum": 1 },
        "representative_users": { "type": "integer", "minimum": 1 },
        "representative_activities": { "type": "integer", "minimum": 1 },
        "demographic_cohort": { "type": "integer", "minimum": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_evidence",
        "qualified_users",
        "deep_dive_authors",
        "published_clusters"
      ],
      "properties": {
        "qualified_evidence": { "type": "integer", "minimum": 0 },
        "qualified_users": { "type": "integer", "minimum": 0 },
        "deep_dive_authors": { "type": "integer", "minimum": 0 },
        "published_clusters": { "type": "integer", "minimum": 0 }
      }
    },
    "missing": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_metric" }
    },
    "aggregate_context": { "$ref": "#/$defs/aggregate_context" },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/cluster" }
    },
    "privacy_note": { "type": "string" }
  },
  "$defs": {
    "counted_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "aggregate_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age_bands", "states", "budget_signals"],
      "properties": {
        "age_bands": { "type": "array", "items": { "$ref": "#/$defs/counted_value" } },
        "states": { "type": "array", "items": { "$ref": "#/$defs/counted_value" } },
        "budget_signals": { "type": "array", "items": { "$ref": "#/$defs/counted_value" } }
      }
    },
    "missing_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "required", "actual"],
      "properties": {
        "metric": { "type": "string" },
        "required": { "type": "integer", "minimum": 1 },
        "actual": { "type": "integer", "minimum": 0 },
        "cluster_id": { "type": "string" },
        "cluster_label": { "type": "string" }
      }
    },
    "representative_user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_code",
        "public_username",
        "selection_score",
        "retained_activity_count",
        "observable_behaviors",
        "supporting_evidence_ids",
        "supporting_evidence_urls",
        "confidence",
        "privacy_note"
      ],
      "properties": {
        "user_code": { "type": "string" },
        "public_username": { "type": "string" },
        "selection_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "retained_activity_count": { "type": "integer", "minimum": 3 },
        "observable_behaviors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "supporting_evidence_ids": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
        "supporting_evidence_urls": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 3, "maxItems": 3 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "privacy_note": { "type": "string" }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "user_count",
        "evidence_count",
        "signals",
        "product_interests",
        "vehicle_platforms",
        "purchase_criteria",
        "recurring_pain_points",
        "explored_solutions",
        "related_communities",
        "vocabulary",
        "aggregate_context",
        "representative_users"
      ],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "user_count": { "type": "integer", "minimum": 12 },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "signals": { "type": "array", "items": { "type": "string" } },
        "product_interests": { "type": "array", "items": { "type": "string" } },
        "vehicle_platforms": { "type": "array", "items": { "type": "string" } },
        "purchase_criteria": { "type": "array", "items": { "type": "string" } },
        "recurring_pain_points": { "type": "array", "items": { "type": "string" } },
        "explored_solutions": { "type": "array", "items": { "type": "string" } },
        "related_communities": { "type": "array", "items": { "type": "string" } },
        "vocabulary": { "type": "array", "items": { "type": "string" } },
        "aggregate_context": { "$ref": "#/$defs/aggregate_context" },
        "representative_users": { "type": "array", "items": { "$ref": "#/$defs/representative_user" }, "minItems": 3, "maxItems": 3 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "clusters": { "minItems": 1 },
          "counts": {
            "properties": {
              "published_clusters": { "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "insufficient_sample" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "published_clusters": { "maximum": 0 }
            }
          }
        }
      }
    }
  ]
}
