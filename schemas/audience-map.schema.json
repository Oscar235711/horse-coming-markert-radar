{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/audience-map.schema.json",
  "title": "Product Community Audience Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "edges", "filters"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "entry_type", "label", "size", "evidence_ids"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["product", "community"] },
          "entry_type": { "enum": ["formal_opportunity", "adjacent_bundle", "community"] },
          "label": { "type": "string" },
          "category": { "type": "string" },
          "size": { "type": "number", "minimum": 0 },
          "opportunity_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "product_count": { "type": "integer", "minimum": 0 },
          "formal_product_count": { "type": "integer", "minimum": 0 },
          "adjacent_product_count": { "type": "integer", "minimum": 0 },
          "subreddit": { "type": "string" },
          "fitment_tags": { "type": "array", "items": { "type": "string" } },
          "pain_points": { "type": "array", "items": { "type": "string" } },
          "solution_ideas": { "type": "array", "items": { "type": "string" } },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "source_type", "target", "target_type", "evidence_ids"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "source_type": { "enum": ["product"] },
          "target": { "type": "string" },
          "target_type": { "enum": ["community"] },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "entry_types"],
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "entry_types": {
          "type": "array",
          "items": { "enum": ["adjacent_bundle", "formal_opportunity"] }
        }
      }
    }
  }
}
